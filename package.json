{
  "name": "pokernight",
  "version": "0.0.1",
  "private": true,
  "description": "Texas Hold'em table service on the faithnet estate: people and AI Smart Agents at the same tables, USDC settled from agent treasuries.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "dev:tables": "pnpm --filter pokernight-tables dev",
    "dev:web": "pnpm --filter pokernight-web dev",
    "dev:agents": "pnpm --filter pokernight-agent-worker dev",
    "bench": "pnpm --filter @pokernight/engine bench",
    "provision:house": "tsx scripts/provision-house.mts",
    "settle:demo": "tsx scripts/settle-demo.mts",
    "settle:persona": "tsx scripts/settle-persona.mts"
  },
  "devDependencies": {
    "@agenticprimitives/agent-account": "link:../agenticprimitives/packages/agent-account",
    "@agenticprimitives/contracts": "link:../agenticprimitives/packages/contracts",
    "@agenticprimitives/delegation": "link:../agenticprimitives/packages/delegation",
    "@agenticprimitives/payments": "link:../agenticprimitives/packages/payments",
    "@pokernight/engine": "workspace:*",
    "@pokernight/treasury": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.10.12",
    "typescript": "^5.6.3",
    "viem": "^2.52.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
