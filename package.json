{
  "name": "pokernight",
  "version": "0.0.1",
  "private": true,
  "description": "Texas Hold'em table service on the faithnet estate: people and AI Smart Agents at the same tables, settled in the card room's own currency (Sheqel) from agent treasuries.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "dev:tables": "pnpm --filter pokernight-tables dev",
    "dev:web": "pnpm --filter pokernight-web dev",
    "dev:agents": "pnpm --filter pokernight-agent-worker dev",
    "bench": "pnpm --filter @pokernight/engine bench",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "check:place": "node scripts/place-compat.mjs",
    "gen:story": "node scripts/place-to-plan.mjs > apps/web/src/components/mystery/plan.generated.ts && node scripts/story-to-title.mjs > packages/mystery/src/titles/belvedere-snowfall.generated.ts && node scripts/story-to-archetypes.mjs",
    "gen:commission": "node scripts/world-to-commission.mjs > packages/commission/src/worlds/kettlewater.generated.ts && node scripts/world-to-commission.mjs ~/skills/ontology/weld.ttl > packages/commission/src/worlds/weld.generated.ts && node scripts/place-to-plan.mjs ~/skills/ontology/kettlewater-house.ttl --name KETTLEWATER_HOUSE > apps/web/src/components/commission/plan.generated.ts && node scripts/place-to-plan.mjs ~/skills/ontology/greeley-church.ttl --name GREELEY_CHURCH > apps/web/src/components/commission/plan.greeley.generated.ts",
    "provision:house": "tsx scripts/provision-house.mts",
    "deploy:sheqel": "tsx scripts/deploy-sheqel.mts",
    "test:contracts": "forge test --root contracts",
    "settle:demo": "tsx scripts/settle-demo.mts",
    "settle:persona": "tsx scripts/settle-persona.mts",
    "play:canasta": "node scripts/play-canasta.cjs",
    "walk:nav": "node scripts/walk-nav.cjs",
    "play:canasta:practice": "node scripts/play-canasta.cjs --practice",
    "walk:club": "node scripts/walk-club.cjs",
    "walk:money": "node scripts/walk-money.cjs",
    "walk:fill": "node scripts/walk-fill.cjs",
    "walk:coach": "node scripts/walk-coach.cjs",
    "walk:round-end": "node scripts/walk-round-end.cjs",
    "mint:house-wire": "tsx scripts/mint-house-wire.mts",
    "verify:house-wire": "tsx scripts/verify-house-wire.mts",
    "ask:as-house": "tsx scripts/ask-as-house.mts",
    "bench:preflop": "tsx bench/pokerbench.mts --set preflop",
    "bench:postflop": "tsx bench/pokerbench.mts --set postflop",
    "bench:chart": "tsx bench/build-preflop-chart.mts && tsx bench/build-postflop-chart.mts",
    "provision:missions-registry": "tsx scripts/provision-missions-registry.mts"
  },
  "devDependencies": {
    "@agenticprimitives/a2a": "0.0.0-alpha.22",
    "@agenticprimitives/agent-account": "1.0.0-alpha.24",
    "@agenticprimitives/contracts": "1.0.0-alpha.24",
    "@agenticprimitives/delegation": "1.0.0-alpha.24",
    "@agenticprimitives/payments": "0.0.0-alpha.20",
    "@agenticprimitives/registry-kit": "0.0.0-alpha.12",
    "@agenticprimitives/types": "1.0.0-alpha.24",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@pokernight/engine": "workspace:*",
    "@pokernight/missions": "workspace:*",
    "@pokernight/protocol": "workspace:*",
    "@pokernight/treasury": "workspace:*",
    "@types/n3": "^1.26.4",
    "@types/node": "^24.0.0",
    "n3": "^2.7.12",
    "playwright": "1.59.1",
    "tsx": "^4.19.0",
    "turbo": "^2.10.12",
    "typescript": "^5.6.3",
    "viem": "^2.52.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
