{
  "name": "pokernight-tables",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Table service: Cloudflare Worker with one PokerTableDO per table (WebSockets, SQLite, alarms) and a LobbyDO.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "test -n \"$WRANGLER_ENV\" || (echo 'set WRANGLER_ENV=faithnet' && exit 1); wrangler deploy --env $WRANGLER_ENV",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agenticprimitives/a2a": "0.0.0-alpha.22",
    "@agenticprimitives/agent-account": "1.0.0-alpha.24",
    "@agenticprimitives/connect-client": "1.0.0-alpha.14",
    "@agenticprimitives/contracts": "1.0.0-alpha.24",
    "@agenticprimitives/delegation": "1.0.0-alpha.24",
    "@agenticprimitives/payments": "0.0.0-alpha.20",
    "@agenticprimitives/types": "1.0.0-alpha.24",
    "@pokernight/engine": "workspace:*",
    "@pokernight/ledger": "workspace:*",
    "@pokernight/protocol": "workspace:*",
    "@pokernight/treasury": "workspace:*",
    "hono": "^4.6.14",
    "viem": "^2.52.2",
    "zod": "^3.24.0",
    "@pokernight/table-game": "workspace:*",
    "@pokernight/canasta": "workspace:*",
    "@agenticprimitives/agent-naming": "1.0.0-alpha.24",
    "@pokernight/canasta-agent": "workspace:*",
    "@pokernight/agent-kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20260907.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.61.1"
  }
}
