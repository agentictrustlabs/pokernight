{
  "name": "pokernight-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web client: Vite + React SPA served by a Worker. Lobby, table view, WebSocket play.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "deploy": "test -n \"$WRANGLER_ENV\" || (echo 'set WRANGLER_ENV=faithnet' && exit 1); vite build --mode $WRANGLER_ENV && wrangler deploy --env $WRANGLER_ENV"
  },
  "dependencies": {
    "@agenticprimitives/connect-client": "1.0.0-alpha.14",
    "@cloudflare/realtimekit-react": "0.1.0",
    "@pokernight/engine": "workspace:*",
    "@pokernight/missions": "workspace:*",
    "@pokernight/protocol": "workspace:*",
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "leaflet": "1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@pokernight/canasta": "workspace:*",
    "@types/leaflet": "1.9.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4",
    "wrangler": "^4.61.1"
  }
}
