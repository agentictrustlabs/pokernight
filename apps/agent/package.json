{
  "name": "pokernight-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reference poker agents: a rules-based bot that plays over WebSocket (phase 1) and the poker.act A2A skill (phase 2).",
  "scripts": {
    "bot": "node --import tsx ./src/bot.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agenticprimitives/a2a": "0.0.0-alpha.22",
    "@agenticprimitives/types": "1.0.0-alpha.24",
    "@pokernight/agent-kit": "workspace:*",
    "@pokernight/engine": "workspace:*",
    "@pokernight/protocol": "workspace:*",
    "viem": "^2.52.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
